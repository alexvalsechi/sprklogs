{
  "name": "log-sparkui",
  "private": true,
  "packageManager": "npm@11.9.0",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "npm --workspace @log-sparkui/desktop start",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:python": "bash infra/scripts/build-python.sh",
    "build:desktop:local": "powershell -ExecutionPolicy Bypass -File infra/scripts/build-desktop-local.ps1",
    "debug:desktop:local": "powershell -ExecutionPolicy Bypass -File infra/scripts/build-desktop-local.ps1 -SkipDist -DebugUnpacked",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "semantic-release": "25.0.8",
    "turbo": "2.8.17"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
